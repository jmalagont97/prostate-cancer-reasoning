# =============================================================================
# CHIMERA Generalist Agent — self-contained production inference image.
#
# - Gemma 4 E2B (gemma4:e2b) is BAKED into the image: the container runs
#   correctly with `--network none` (Grand Challenge contract).
# - Ollama is the official CUDA-enabled binary; the NVIDIA GPU is exposed at
#   runtime via the host nvidia-container-runtime (`docker run --gpus all`).
# - Task models (.pkl) are mounted at runtime from training artifacts.
# =============================================================================

# --- Stage 0: bake the LLM into the image ---------------------------------
FROM ollama/ollama:latest AS model-bake

# Pull the invariant model with network available at BUILD time only.
RUN ollama serve & \
    for i in $(seq 1 60); do \
      curl -sf http://127.0.0.1:11434/api/version >/dev/null 2>&1 && break; \
      sleep 1; \
    done && \
    ollama pull gemma4:e2b

# --- Stage 1: runtime ------------------------------------------------------
FROM ollama/ollama:latest AS runtime

LABEL org.grand-challenge.api-method="invoke"

# Ollama's official image is Ubuntu-based without Python; add Python 3.11.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Grand Challenge runs algorithms as an unprivileged user.
RUN useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /opt/ollama/models /opt/ml/model \
    && chown -R appuser:appuser /opt/ollama /opt/ml/model

WORKDIR /opt/app

# Python deps required by the serialized tabular/survival models and SHAP-based tasks.
COPY deploy/agent_submission/requirements.txt ./requirements.txt
# Keep Torch for deserializing the Task-1 KDM, but use the CPU-only wheel.
# Ollama/Gemma retains its independent GPU runtime from the official base image.
RUN pip install --no-cache-dir --break-system-packages \
        torch==2.13.0+cpu --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --break-system-packages -r requirements.txt

# Agent source, templates, configs, entrypoint.
COPY deploy/agent_submission/src/ /opt/app/src/
COPY deploy/agent_submission/templates/ /opt/app/templates/
COPY deploy/agent_submission/configs/ /opt/app/configs/
COPY deploy/agent_submission/inference.py /opt/app/inference.py
COPY deploy/agent_submission/entrypoint.sh /opt/app/entrypoint.sh
COPY deploy/agent_submission/pyproject.toml /opt/app/pyproject.toml
# Training model_definitions needed to unpickle the subtask .pkl models
# (import path deploy.tasks.task1.training.model_definitions).
COPY deploy/tasks/task1/training/model_definitions.py /opt/app/deploy/tasks/task1/training/model_definitions.py
COPY deploy/tasks/task2/model_definitions.py /opt/app/deploy/tasks/task2/model_definitions.py
COPY deploy/tasks/task2/preprocessing.py /opt/app/deploy/tasks/task2/preprocessing.py
# Task-3 inference modules needed by the MCP Cox tool.
COPY deploy/tasks/task3/model_definitions.py /opt/app/deploy/tasks/task3/model_definitions.py
COPY deploy/tasks/task3/preprocessing.py /opt/app/deploy/tasks/task3/preprocessing.py
COPY deploy/tasks/task3/inference.py /opt/app/deploy/tasks/task3/inference.py
# Canonical Task-1 artifacts generated by the training pipeline.
RUN mkdir -p /opt/ml/model
COPY deploy/tasks/task1/training/models/subtask1_ensemble.pkl /opt/ml/model/subtask1_ensemble.pkl
COPY deploy/tasks/task1/training/models/subtask2_kdm.pkl /opt/ml/model/subtask2_kdm.pkl
COPY deploy/tasks/task1/training/models/subtask3_extratrees.pkl /opt/ml/model/task1_subtask3_extratrees.pkl
COPY deploy/tasks/task3/training/models/task3_cox_pca5.pkl /opt/ml/model/task3_cox_pca5.pkl
RUN mkdir -p /opt/ml/model/task2
COPY deploy/tasks/task2/training/models/subtask1_ensemble.pkl /opt/ml/model/task2/subtask1_ensemble.pkl
COPY deploy/tasks/task2/training/models/subtask2_knn.pkl /opt/ml/model/task2/subtask2_knn.pkl
COPY deploy/tasks/task2/training/models/subtask3_extratrees.pkl /opt/ml/model/task2/subtask3_extratrees.pkl

# Install the application as a normal production package.
RUN pip install --no-cache-dir --break-system-packages /opt/app

# Copy the baked model blobs into the unprivileged Ollama model root.
COPY --from=model-bake /root/.ollama/models /opt/ollama/models

ENV HOME=/home/appuser
ENV OLLAMA_MODELS=/opt/ollama/models
ENV SUBMODELS_DIR=/opt/ml/model
ENV PYTHONPATH=/opt/app/src:/opt/app

RUN chmod +x /opt/app/entrypoint.sh

WORKDIR /opt/app
USER appuser
EXPOSE 4743
ENTRYPOINT ["/opt/app/entrypoint.sh"]
